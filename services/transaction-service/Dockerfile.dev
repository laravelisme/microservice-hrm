FROM golang:1.24.2-alpine

RUN apk add --no-cache git ca-certificates bash

ENV GOPATH=/go
ENV PATH=${GOPATH}/bin:/usr/local/go/bin:${PATH}
# Limit Go runtime to 1 CPU to reduce CPU usage in dev
ENV GOMAXPROCS=1

WORKDIR /src

# Copy mod files and download modules at image build time (speeds up runtime rebuilds)
COPY go.mod go.sum ./
RUN go mod download

# Install CompileDaemon (dev reloader) at build time (compatible with Go 1.24)
RUN go install github.com/githubnemo/CompileDaemon@latest

# Expose application port
EXPOSE 3000

# Disable CGO and limit build parallelism for lower CPU usage during build
ENV CGO_ENABLED=0
ENTRYPOINT ["/go/bin/CompileDaemon", "-directory=/src", "-recursive", "-pattern=\\.go$", "-build=go build -p 1 -o /tmp/app ./cmd", "-command=/tmp/app"]


# Root .gitignore for hrm-dev-app monorepo
# Covers Go, PHP/Laravel, Node, Docker, editors, OS, build artifacts, and secrets

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Editor / IDE
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*~
*.tmp
*.bak
*.old

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp.*
.pnp

# Build output
dist/
build/
public/build/
public/hot
npm-debug.log

# PHP / Composer
/vendor/
/.phpunit.result.cache
/.php_cs.cache
*.phpunit.result.cache
composer.phar

# Laravel stuff
**/storage/*.key
**/storage/*.cache
**/storage/*.log
**/storage/logs/
**/storage/framework/
.env
.env.*
.env.local
.env.testing
Homestead.yaml
Homestead.json
/public/storage
/storage/*.key

# Go
# Binaries for programs and plugins
/bin/
/bin/*
/*.exe
/*.dll
/*.so
/*.dylib
/tmp/app
*.test
coverage.out
*.out
/pkg/

# Go workspace file
Godeps/

# GoLand
.idea/
*.iml

# Docker
docker-compose.override.yml
docker-compose.local.yml
*.local.env
**/docker-compose.override.yml
**/docker-compose.*.yml
acme.json

# Logs
logs/
*.log
npm-debug.log*

# Misc
*.cache
.cache/
*.pid
*.seed
*.pid.lock

# Temporary files
tmp/
temp/
cache/

# OS-specific
.vagrant/
*.box

# Certificates and secrets
*.pem
*.key
*.crt

# Terraform
*.tfstate
*.tfstate.backup
.terraform/

# JetBrains
/.idea/
*.iws
*.iml
*.ipr

# Coverage
coverage/
.coverage

# Ignore compiled assets in services (if generated)
**/public/mix-manifest.json
**/public/build/
**/public/js/
**/public/css/

# Ignore node build caches
.cache/

# Keep .gitignore tracked
!.gitignore
